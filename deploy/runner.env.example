# Create deploy/runner.env locally (never commit the real file).
# Generate a repository runner token in:
# GitHub repository → Settings → Actions → Runners → New self-hosted runner.
TRADING_AGENT_RUNNER_ENV_FILE=/home/hariohm/indian-trading-agent/deploy/runner.env
RUNNER_REPO_URL=https://github.com/HariohmBhatt/indian-trading-agent-alpha
RUNNER_TOKEN=replace-with-a-fresh-repository-runner-token
RUNNER_NAME=dellg15-prod-runner
RUNNER_LABELS=trading-agent-prod
