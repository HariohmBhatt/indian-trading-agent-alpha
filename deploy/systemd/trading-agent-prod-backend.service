[Unit]
Description=Indian Trading Agent PROD - FastAPI Backend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hariohm
Group=hariohm
WorkingDirectory=/home/hariohm/indian-trading-agent-prod
Environment=PATH=/home/hariohm/indian-trading-agent-prod/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/hariohm/indian-trading-agent-prod/venv/bin/uvicorn backend.app:app --host 0.0.0.0 --port 8100
Restart=on-failure
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
