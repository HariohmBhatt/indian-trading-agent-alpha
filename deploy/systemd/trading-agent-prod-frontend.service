[Unit]
Description=Indian Trading Agent PROD - Next.js Frontend
After=network-online.target trading-agent-prod-backend.service
Wants=network-online.target trading-agent-prod-backend.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=hariohm
Group=hariohm
WorkingDirectory=/home/hariohm/indian-trading-agent-prod/frontend
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOSTNAME=0.0.0.0
ExecStart=/usr/bin/npm run start -- -H 0.0.0.0 -p 3100
Restart=on-failure
RestartSec=15
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
